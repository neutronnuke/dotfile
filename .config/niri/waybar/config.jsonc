// -*- mode: jsonc -*-
{
  "position": "top", 
  "spacing": 0,
  //"output":"eDP-1",
  //"margin-top": 5,
  //"margin-left": 5,
  //"margin-bottom": 0,
  //"margin-right": 5,
  "exclusive": true,
  "fixed-center": true,
  "gtk-layer-shell": true,
  "mode": "dock",
  "passthrough": false,
  "modules-left": ["custom/sep","clock","custom/sep","niri/workspaces","niri/window"],
  //"modules-center": [],
  "modules-right": [
    "keyboard-state",
    "custom/sep",
	"cpu",
	"custom/sep",
	//"memory",
	//"custom/sep",
	"pulseaudio",
	"custom/sep",
	"battery",
	"custom/sep",
	"network", 
	"custom/sep",
	"tray",
    "custom/sep"
    ],

    "clock": {
      //"format": "󰥔 {:%H:%M}",
      "format": "{:%H:%M}",
      "tooltip": true,
	  "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#f1fa8c'><b>{}</b></span>",
                "weekdays": "<span color='#ffb86c'><b>{}</b></span>",
                "today": "<span color='#50fa7b'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

	"clock#waktu": {
			"format": "{:%d %B %Y}",
            "tooltip": false
    },

  "battery": {
    //"interval": 5,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "󰁹{icon} {capacity}%",
	"format-charging": "󰁹{icon} {capacity}%",
    "format-plugged": "󰁹󱐋{icon} {capacity}%",
	"format-full": "󰁹󱐋{icon} {capacity}%",
    //"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
	//"format-icons": [" ", " ", " ", " ", " "],
	"format-icons": ["░░░░░░░░░░", "▓░░░░░░░░░", "▓▓░░░░░░░░", "▓▓▓░░░░░░░", "▓▓▓▓░░░░░░", "▓▓▓▓▓░░░░░","▓▓▓▓▓▓░░░░","▓▓▓▓▓▓▓░░░","▓▓▓▓▓▓▓▓░░","▓▓▓▓▓▓▓▓▓░","▓▓▓▓▓▓▓▓▓▓"],
    //"max-length": 25,
    "tooltip": true,
    "tooltip-format": "{time} left\nCapacity: {health}%\n{power} watts"
  },

  "cpu": {
    "interval": 1,
    "format": "󰻠 {icon}",
    //"max-length": 10,
    "format-icons": ["░░░░░░░░░░", "▓░░░░░░░░░", "▓▓░░░░░░░░", "▓▓▓░░░░░░░", "▓▓▓▓░░░░░░", "▓▓▓▓▓░░░░░","<span foreground='#ffb86c'>▓▓▓▓▓▓░░░░</span>","<span foreground='#ffb86c'>▓▓▓▓▓▓▓░░░</span>","<span foreground='#ff5555'>▓▓▓▓▓▓▓▓░░</span>","<span foreground='#ff5555'>▓▓▓▓▓▓▓▓▓░</span>","<span foreground='#ff5555'>▓▓▓▓▓▓▓▓▓▓</span>"],
    "tooltip": false
  },

  "memory": {
    "interval": 30,
    "format": " Mem:{used}GiB",
    "tooltip": false,
    "tooltip-format": "{used:0.1f}GiB used\n{avail:0.1f}GiB available"
    //"max-length": 10
  },

  "niri/workspaces": {
  	"format":"{icon}",
	"active-only":true,
    "disable-scroll": true,
    "all-outputs": false,
    "on-click": "activate",
    "sort-by-number": true,
    "format-icons": {
        "focused":"",
        "default":"",
        "active":""
     }
    },

    "network": {
    //    "interval": 5,
      	//"format-wifi": "",
          "format-wifi": " {icon} {signalStrength}%",
        "format-ethernet": "󰈀 online",
        "format-linked": "󱛆 {icon}",
        "format-disconnected": "󱚼 {icon}",
        "format-disabled": "󱚼 {icon}",
        //"format-alt": "<span foreground='#50fa7b'>  {bandwidthUpBits} |  {bandwidthDownBits}</span>",
        //"tooltip-format-wifi": "WIFI connected with {signalStrength}% strength",
        "tooltip-format-wifi": "Connected to {essid}\nFrequenzy: {frequency}MHz\nStrength: {signaldBm}dBm ({signalStrength}%)\nIP: {ipaddr}/{cidr}",//\n {bandwidthUpBits}  {bandwidthDownBits}",
        "tooltip-format": " {ifname} via {gwaddr}",
        //"max-length": 20,
        "tooltip": true,
       // "on-click": "kitty -T nmtui -e nmtui",
	//"format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"]
	"format-icons": ["░░░░░░░░░░", "▓░░░░░░░░░","▓▓░░░░░░░░", "▓▓▓░░░░░░░", "▓▓▓▓░░░░░░", "▓▓▓▓▓░░░░░","▓▓▓▓▓▓░░░░","▓▓▓▓▓▓▓░░░","▓▓▓▓▓▓▓▓░░","▓▓▓▓▓▓▓▓▓░","▓▓▓▓▓▓▓▓▓▓"]
    },

    "network#wifiname": {
      	"format-wifi": "ESSID:{essid}",
        "format-ethernet": "{ifname} via {gwaddr}",
        "format-disconnected": "DISCONNECTED",
        "format-disabled": "DISABLED",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "󰕾 {icon} {volume}%",
        "tooltip": false,
		"tooltip-format": "Volume: {volume}%",
        "format-muted": "󰕾 {icon} {volume}%",
        "on-click": "~/.config/hypr/scripts/volume --toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "~/.config/hypr/scripts/volume --inc",
        "on-scroll-down": "~/.config/hypr/scripts/volume --dec",
        "ignored-sinks": ["Easy Effects Sink"],
        "smooth-scrolling-threshold": 1,
        "format-icons": ["░░░░░░░░░░","▓░░░░░░░░░", "▓▓░░░░░░░░", "▓▓▓░░░░░░░", "▓▓▓▓░░░░░░", "▓▓▓▓▓░░░░░","▓▓▓▓▓▓░░░░","▓▓▓▓▓▓▓░░░","▓▓▓▓▓▓▓▓░░","▓▓▓▓▓▓▓▓▓░","▓▓▓▓▓▓▓▓▓▓"]
    },

  "tray": {
	"icon-size": 10,
    "tooltip": false,
    "spacing": 4
  },

  "custom/sep": {
    "format":"|",
	"tooltip":false
  },
  	"keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": {
      		"numlock": " 󰎠 ",
      		"capslock": " 󰪛 ",
    	},
    "format-icons": {
        "locked": "",
        "unlocked": ""
    }
    },

  "niri/window": {
    "icon":false,
    "icon-size":14,
    "format": "▶ {title}",
    "separate-outputs": true,
    "max-length": 100
  },

  "wlr/taskbar": {
    "all-outputs": false,
    "format": "{icon}",
    "active-first":false,
    "icon-size": 14,
    "icon-theme": "Dracula",
    "tooltip": true,
    "tooltip-format": "{title}",
    "on-click": "activate",
    //"on-click-middle": "close",
    "ignore-list": [
       "Alacritty"
    ],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    },
    "rewrite": {
        "Firefox Web Browser": "Firefox",
        "Foot Server": "Terminal"
    }
  },
	
    "group/net":{
	  "orientation": "inherit",
	  "modules": ["network","network#wifiname"],
	  "drawer": {
        "transition-duration": 500,
    //    "children-class": "not-power",
        "transition-left-to-right": false,
      },
    },
}
