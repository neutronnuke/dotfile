# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
	    output_format = "i3bar"
        colors = true
        markup = pango
        interval = 5
        color_good = "#50FA7B"
        color_bad = "#FF5555"
        color_degraded = "#ffb86c"
}

# order += "ipv6"
order += "cpu_usage"
#order += "cpu_temperature 0"
# order += "cpu_temperature 1"
# order += "load"
# order += "disk /"
# order += "disk /home"
order += "memory"
order += "ethernet _first_"
order += "wireless _first_"
order += "volume master"
order += "battery all"
order += "tztime local"
#order += "tztime localtime"

cpu_usage {
        format ="C: %usage"
        #format = "<span background='#50fa7b'>  %usage</span>"
}

ethernet _first_ {
# if you use %speed, i3status requires root privileges
        #format_up = "󰈀 CONNECTED"
		format_up = "E: online"
        #format_down = "󰈀 OFFLINE"
		format_down = "E: offline" 
}

wireless _first_ {
# if you use %speed, i3status requires root privileges
        format_up = "W:%essid (%quality)"
        format_down = "W: offline" 
}

volume master {
        format = "VOL: %volume"
        #format = "󰕾 %volume"
        format_muted = "<span foreground='#ff5555'>VOL: muted</span>"
        #format_muted = "󰖁 %volume Muted"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

battery all {
	format = "%status %percentage"
	last_full_capacity = true
        #format = "%status %percentage"
        format_down = "No battery"
        last_full_capacity = true
        integer_battery_capacity = true
        #status_chr = " "
        status_chr = "CHR:"
        status_bat = "BAT:"
        #status_bat = " "
        # status_bat = "Battery "
        status_unk = "?"
        # status_unk = "Unknown "
        #status_full = " "
        status_full = "BAT:"
        low_threshold = 30
        threshold_type = percentage
}

memory {
		#memory_used_method="memavailable"
        format = "M: %used (%available)"
		#format = "<span background='#8be9fd'>  %used (%available) </span>"
        threshold_degraded = "10%"
        format_degraded = "MEMORY < %available"
}

tztime local {
		format = "%H:%M "
		#format_time = " %a %-d %b %H:%M"
}

tztime localtime {
        format = "[%H:%M]"
}
