set window-title-basename "true"
set selection-clipboard "clipboard"
set font "JetBrains Mono 10"

# Dracula color theme for Zathura
# Swaps Foreground for Background to get a light version if the user prefers

#
# Dracula color theme
#

set notification-error-bg       "#bf616a" # Red
set notification-error-fg       "#eceff4" # Foreground
set notification-warning-bg     "#d08770" # Orange
set notification-warning-fg     "#434c5e" # Selection
set notification-bg             "#2e3440" # Background
set notification-fg             "#eceff4" # Foreground

set completion-bg               "#2e3440" # Background
set completion-fg               "#5e81ac" # Comment
set completion-group-bg         "#2e3440" # Background
set completion-group-fg         "#5e81ac" # Comment
set completion-highlight-bg     "#434c5e" # Selection
set completion-highlight-fg     "#eceff4" # Foreground

set index-bg                    "#2e3440" # Background
set index-fg                    "#eceff4" # Foreground
set index-active-bg             "#434c53" # Current Line
set index-active-fg             "#eceff4" # Foreground

set inputbar-bg                 "#2e3440" # Background
set inputbar-fg                 "#eceff4" # Foreground
set statusbar-bg                "#2e3440" # Background
set statusbar-fg                "#eceff4" # Foreground

set highlight-color             "#d08770" # Orange
set highlight-active-color      "#ff79c6" # Pink

set default-bg                  "#2e3440" # Background
set default-fg                  "#eceff4" # Foreground

set render-loading              true
set render-loading-fg           "#2e3440" # Background
set render-loading-bg           "#eceff4" # Foreground

#
# Recolor mode settings
#

set recolor-lightcolor          "#2e3440" # Background
set recolor-darkcolor           "#eceff4" # Foreground

#
# Startup options
#
set adjust-open width
set recolor true
