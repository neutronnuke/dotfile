#======================== Shadow ===============================#
shadow = true;
shadow-radius = 7;
shadow-opacity = 0.5;
shadow-offset-x = -7;
shadow-offset-y = -7;

shadow-exclude = [
  "name = 'Notification'",
  "class_g = 'rofi'",
  "class_g = 'maim'",
#  "class_g = 'i3-frame'",
  "class_g = 'firefox' && argb",
  "class_g = 'thunderbird' && argb",
  "class_g = 'Mail' && argb",
  "class_g = 'polybar'",
  "class_g = 'bottles'",
  "class_g = 'monophony'",
  "class_g = 'bar-0'",
  "class_g = 'i3bar'",
  "class_g = 'mpv'",
  "class_g = 'Polybar'",
  "class_g = 'Dunst'",
  "class_g ?= 'Notify-osd'",
  "class_g = 'Cairo-clock'",
#  "override_redirect = true",
  "_GTK_FRAME_EXTENTS@:c"
];

#======================== Fading ===============================#
fading = false;
fade-in-step = 0.03;
fade-out-step = 0.03;
#fade-delta = 8;

fade-exclude = [
  "class_g = 'slop'"
]

#======================== Opacity ==============================#
#inactive-opacity = 1;
#frame-opacity = 0.7;
#inactive-opacity-override = false;
#active-opacity = 1.0;
#inactive-dim = 0.0;
#
#focus-exclude = [ 
#  "class_g = 'Cairo-clock'",
#  "class_g ?= 'rofi'",
#  "class_g ?= 'slop'"
#];

#======================== Corner ===============================#
#corner-radius = 10;
#round-borders = 1;
#
#rounded-corners-exclude = [
#  "window_type = 'dock'",
#  "window_type = 'desktop'",
#  "class_g = 'polybar'",
#  "class_g = 'dmenu'"
#];
#blur = {
#  method = "gaussian";
#  size = 8;
#  deviation = 2;
#};
#

#========================= Animations ==========================#
#animations = true
#
#animation-for-transient-window = "zoom"
#animation-for-open-window = "zoom"
#animation-for-unmap-window = "zoom"
#
#animation-dampening = 20
#animation-clamping = false

#======================== General Settings =====================#
backend = "glx";
vsync = true;
dbus = false;
daemon = false;
#mark-wmwin-focused = true;
#mark-ovredir-focused = true;
#detect-rounded-corners = true;
#detect-client-opacity = true;
#detect-transient = true;
#detect-client-leader = true;
#resize-damage = 1;
#glx-no-stencil = true;
#use-damage = true;
#transparent-clipping = false;
#log-level = "warn";

wintypes:
{
  tooltip = { fade = true; shadow = false; focus = true; };
  menu = { full-shadow = true; };
  dock = { full-shadow = true; };
  dnd = { full-shadow = true; };
  popup_menu = { full-shadow = true; };
  dropdown_menu = { full-shadow = true; };
  normal = { full-shadow = true; };
  notification = { full-shadow = true; };
  dialog = {  full-shadow = true; };
  toolbar = { full-shadow = true; };
};

rules: ({
  match = "window_type = 'tooltip'";
  fade = false;
  shadow = true;
  opacity = 0.75;
  full-shadow = false;
}, {
  match = "window_type = 'dock'    || "
          "window_type = 'desktop' || "
          "_GTK_FRAME_EXTENTS@";
  blur-background = false;
}, {
  match = "window_type != 'dock'";
  # shader = "my_shader.frag";
}, {
  match = "window_type = 'dock' || "
          "window_type = 'desktop'";
  corner-radius = 0;
}, {
  match = "name = 'Notification'   || "
          "class_g = 'Conky'       || "
          "class_g ?= 'Notify-osd' || "
          "class_g = 'Cairo-clock' || "
          "_GTK_FRAME_EXTENTS@";
  shadow = false;
})
